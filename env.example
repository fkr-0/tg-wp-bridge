# Copy this file to ".env" and adjust values for your environment.
# The Settings class in tg_wp_bridge/config.py will automatically load .env.

# Path to Docker Compose file, allows to run docker compose from basedir
COMPOSE_FILE="docker/docker-compose.yml"

# Telegram configuration
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=supersecretpathsegment
PUBLIC_BASE_URL=https://bridge.example.com

# Optional: Webhook path prefix (default: "webhook")
# Full webhook path will be: /{WEBHOOK_PREFIX}/{TELEGRAM_WEBHOOK_SECRET}
# WEBHOOK_PREFIX=webhook

# WordPress configuration
WP_BASE_URL=http://localhost:8080
WP_USERNAME=admin
WP_APP_PASSWORD=app-password-from-wordpress

# Optional: ID of the category to assign to mirrored posts.
WP_CATEGORY_ID=1

# Optional: Post status for new WordPress posts.
# Options: publish, draft, pending
WP_PUBLISH_STATUS=publish

# Optional: Post type to create.
# Options: post (default), page, or custom post type name
# WP_POST_TYPE=post

# Optional: Use first photo as featured media (excluded from gallery).
# When true: first photo is featured image and not shown in content gallery.
# When false (default): all media appears only in content gallery (no featured).
# WP_USE_FEATURED_MEDIA=false

# Optional: only mirror messages that contain this hashtag (including '#').
# Leave empty or remove to mirror all channel messages.
# REQUIRED_HASHTAG=#blog

# Optional: Comma-separated list of allowed Telegram chat types.
# Defaults to "channel". Example: channel,supergroup,group
# CHAT_TYPE_ALLOWLIST=channel

# Optional hashtag allow/block lists (include leading '#').
# HASHTAG_ALLOWLIST=#blog,#news
# HASHTAG_BLOCKLIST=#offtopic
